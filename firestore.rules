rules_version = '2';

// Baseline rules for the shared multi-branch Firestore project.
//
// What this enforces:
//   - Nobody unauthenticated can read or write anything (blocks the public-internet
//     default-deny gap that an empty/missing rules file would otherwise leave open).
//   - Every write to a synced collection must carry a non-empty "branchId" field that
//     matches the document's existing branchId (so a client can't silently switch a
//     record from one branch to another, and can't write a document with no branchId
//     at all going forward).
//
// What this does NOT (yet) enforce:
//   - That a signed-in user is only allowed to write branchId == "dusri-branch" (or
//     whichever branch their device belongs to). Doing that requires the server to know
//     which branch each authenticated user/device belongs to — this app currently signs
//     users in via Firebase Phone Auth but has no server-side record of "this phone
//     number belongs to branch X". Until that mapping exists (e.g. a small
//     `branch_members/{uid}` collection set once when a branch's account is provisioned,
//     checked below via get()), any authenticated user from ANY branch's app install can
//     write to ANY branch's data — the app's own BRANCH_ID/pull() filter keeps branches
//     from seeing each other's data in normal use, but a modified/rogue client could not
//     be stopped by these rules alone.
//
// Recommended next step: create branch_members/{uid} -> { branchId: "dusri-branch" }
// once per staff phone number (via Firebase console or a small admin script), then
// tighten the rules below to check it — happy to write that version once that
// collection exists.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasBranchId() {
      return request.resource.data.branchId is string
          && request.resource.data.branchId.size() > 0;
    }

    function branchIdUnchanged() {
      return !resource.data.keys().hasAny(['branchId'])
          || request.resource.data.branchId == resource.data.branchId;
    }

    match /{collection}/{docId}
        where collection in ['customers', 'suppliers', 'products', 'users',
                              'sales', 'purchases', 'payments', 'expenses',
                              'cash_transactions'] {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && hasBranchId();
      allow update: if isSignedIn() && hasBranchId() && branchIdUnchanged();
      allow delete: if isSignedIn();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
